<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.ac.hannam.multi.cricket.mapper.CarOptionsMapper">
    <select id="selectOptionList" parameterType= "CarOptionsVO">
        SELECT
            OPTION_CATEGORY,
            OPTION_ID,
            OPTION_NAME
        FROM CAR_OPTIONS
        ORDER BY OPTION_CATEGORY, OPTION_ID
    </select>

</mapper>